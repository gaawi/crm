# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. See docs/SETUP.md.

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Public URL of the app (OAuth redirect + internal self-requests). On Vercel it
# defaults to the production domain if left unset.
APP_URL=http://localhost:3000

# Login password for the CRM (≥ 12 chars; changing it signs out every device),
# and a random secret for session cookies (≥ 32 chars).
APP_PASSWORD=
SESSION_SECRET=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts Gmail tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail push notifications (recommended): projects/<gcp-project>/topics/<topic>
GMAIL_PUBSUB_TOPIC=
# Shared secret appended to the Pub/Sub push endpoint URL (?token=...): `openssl rand -hex 24`
PUBSUB_VERIFICATION_TOKEN=
# Optional, stronger: also verify the OIDC token Pub/Sub signs each push with
# (set when the subscription uses --push-auth-service-account).
# PUBSUB_AUDIENCE=https://YOUR-APP.vercel.app/api/gmail/push
# PUBSUB_SERVICE_ACCOUNT=gmail-crm-push@<gcp-project>.iam.gserviceaccount.com

# Protects /api/cron/* and internal job requests. Vercel Cron sends it automatically.
CRON_SECRET=

# Optional: Claude inside the CRM (assistant, "Draft with Claude", autopilot).
# Leave empty to run the CRM without it; Claude Code can still use the CRM via /api/mcp.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: enables the MCP endpoint at /api/mcp (Authorization: Bearer <key>)
# MCP_API_KEY=

# Optional: a SELECT-only connection for Claude's free-form SQL tool
# (supabase/optional/readonly-role.sql). Without it that tool is disabled.
# DATABASE_READONLY_URL=

# Optional tuning
# APP_TIMEZONE=America/New_York
# OWN_EMAILS=me@old-domain.com,assistant@creartbox.nyc   # "me" but not connected: never contacts
# SYNC_SKIP_CATEGORIES=promotions,social     # default: import everything (flagged as automated)
# GMAIL_BACKFILL_QUERY=after:2020/01/01       # limit the first import
# DB_SIZE_LIMIT_MB=450                        # import pauses above this (Supabase Free is read-only at 500 MB)
